# Poster figure style — 1×3 horizontal (fig3: Systematic comparison, mols 1–3)
# Based on lineshapes-subplots.mplstyle, tuned for A0 column-width inclusion
# Wider figure compensates for 3-panel layout

figure.figsize: 12, 3.5
figure.autolayout: True
figure.titlesize: x-large
figure.dpi: 300

# Text
text.color: 323034

# Font properties — scaled for A0 poster viewing distance (~1–2 m)
font.size: 7
font.family: serif
pgf.texsystem: pdflatex
text.usetex: True
text.latex.preamble: \usepackage{amsmath}\usepackage{amssymb}\usepackage{siunitx}
pgf.preamble: \usepackage{amsmath}\usepackage{amssymb}\usepackage{siunitx}
pgf.rcfonts: False

# Math things
mathtext.fontset: cm

# Axes properties
axes.labelcolor: black
axes.edgecolor: black
axes.linewidth: 0.6
axes.labelpad: 3
axes.titlesize: 9
axes.labelsize: 9
axes.spines.right: False
axes.spines.top: False
axes.grid: False
axes.titlelocation: center
axes.formatter.use_mathtext: True
axes.autolimit_mode: data
axes.formatter.limits: -4, 4
axes.xmargin: 0
axes.ymargin: 0.02
axes.prop_cycle: (cycler(color=['56B4E9', 'E69F00', '009E73', '0072B2', 'D55E00', 'CC79A7', 'F0E442']) + cycler(linestyle=["-", "-", "--", ":", "-", "--", "-."]))

# Tick properties — x-axis
xtick.color: 323034
xtick.labelsize: 9
xtick.top: False
xtick.direction: out
xtick.major.size: 2.5
xtick.major.width: 0.6
xtick.minor.size: 1.2
xtick.minor.width: 0.5

# Tick properties — y-axis
ytick.color: 323034
ytick.labelsize: 9
ytick.right: False
ytick.direction: out
ytick.major.size: 2.5
ytick.major.width: 0.6
ytick.minor.size: 1.2
ytick.minor.width: 0.5

# Line properties
lines.linewidth: 1.0
lines.markersize: 5
lines.markeredgewidth: 1
markers.fillstyle: none

# Legend properties
legend.framealpha: 0.8
legend.frameon: True
legend.fontsize: 7
legend.title_fontsize: 7
legend.edgecolor: 0.3
legend.borderpad: 0.2
legend.columnspacing: 1.5
legend.labelspacing: 0.4

# Patch
patch.facecolor: bc80bd
patch.force_edgecolor: True
patch.linewidth: 0.3

# Scatter
scatter.edgecolors: face

# Grid
grid.color: b1afb5
