#!/usr/bin/env bash
# AIM4ML pre-commit hook — lint gate (fast, <2s).
# Full test suite is NOT run here (46s); run `pytest curation/tests selection/tests`
# before pushing. Enabling: git config core.hooksPath .git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

RUFF=".venv/bin/ruff"
command -v "$RUFF" >/dev/null 2>&1 || RUFF="$(command -v ruff || true)"
if [ -z "$RUFF" ]; then
    echo "pre-commit: ruff not found (venv or PATH) — skipping lint" >&2
    exit 0
fi

# Only check files staged for commit (.py additions/modifications)
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ ${#files[@]} -eq 0 ] && exit 0

echo "pre-commit: ruff check (${#files[@]} files)"
"$RUFF" check "${files[@]}"

echo "pre-commit: ruff format --check"
"$RUFF" format --check "${files[@]}"

echo "pre-commit: OK"
